[Unit]
Description=d-brain watchdog (recovers a dead/hung Claude session)
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=dbrain-notify@%n.service

[Service]
Type=simple
# KillMode=process: a watchdog restart must NOT kill the tmux brain it spawned
# via force_recover (the brain lives in this cgroup). Previously the default
# control-group + WatchdogSec SIGABRT loop killed the brain every minute.
KillMode=process
# Type=simple (not notify): the loop blocks during force_recover longer than a
# short WatchdogSec, so a systemd WatchdogSec would SIGABRT it mid-recovery and
# take the brain with it. Restart=always covers a crashed watchdog instead.
# A clean stop exits 143 (SIGTERM) — success, must not fire OnFailure=.
SuccessExitStatus=143 SIGTERM
# Separate slice so an OOM kill of the brain doesn't take the watchdog down.
Slice=dbrain-watchdog.slice
WorkingDirectory=%h/projects/dbrain
# Not `uv run`: it keeps a shared flock on ~/.cache/uv/.lock for the whole
# lifetime of the watchdog (weeks), which blocks `uv cache prune` forever.
# Sync once (--inexact = what `uv run` did), then start python directly.
ExecStartPre=%h/.local/bin/uv sync --inexact
ExecStart=%h/projects/dbrain/.venv/bin/python -m d_brain.services.watchdog
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=CLAUDE_CONFIG_DIR=%h/.dbrain-claude
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HTTPS_PROXY=http://127.0.0.1:8118
Environment=HTTP_PROXY=http://127.0.0.1:8118
Environment=NO_PROXY=127.0.0.1,localhost,::1,192.168.2.44
Environment=NODE_EXTRA_CA_CERTS=/opt/mhr-cfw/ca/ca.crt

[Install]
WantedBy=default.target
