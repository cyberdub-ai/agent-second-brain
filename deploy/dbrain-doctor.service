[Unit]
Description=d-brain daily self-diagnostic
OnFailure=dbrain-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/dbrain
ExecStart=%h/.local/bin/uv run python -m d_brain.services.doctor
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CLAUDE_CONFIG_DIR=%h/.dbrain-claude
Environment=HTTPS_PROXY=http://127.0.0.1:8118
Environment=HTTP_PROXY=http://127.0.0.1:8118
Environment=NO_PROXY=127.0.0.1,localhost,::1,192.168.2.44
Environment=NODE_EXTRA_CA_CERTS=/opt/mhr-cfw/ca/ca.crt
